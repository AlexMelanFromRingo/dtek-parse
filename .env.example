# Telegram Bot Token (required)
# Get from @BotFather on Telegram
TELOXIDE_TOKEN=your_bot_token_here

# Database URL (optional, default: sqlite:dtek_bot.db)
DATABASE_URL=sqlite:dtek_bot.db?mode=rwc

# Cache duration in minutes (optional, default: 30)
# Recommended: 30-60 minutes to reduce load on DTEK website
CACHE_DURATION_MINUTES=30

# Logging level (optional)
RUST_LOG=info

# For running tests
# RUST_BACKTRACE=1
